<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="PedidosService" targetNamespace="http://demo.example/pedidos"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:p="http://demo.example/pedidos">
    <wsdl:types>
        <xs:schema targetNamespace="http://demo.example/pedidos" elementFormDefault="qualified">
            <xs:element name="consultarPedido">
                <xs:complexType><xs:sequence><xs:element name="pedidoId" type="xs:int"/></xs:sequence></xs:complexType>
            </xs:element>
            <xs:element name="consultarPedidoResponse">
                <xs:complexType><xs:sequence>
                    <xs:element name="pedidoId" type="xs:int"/>
                    <xs:element name="estado" type="xs:string"/>
                    <xs:element name="total" type="xs:decimal"/>
                    <xs:element name="folio" type="xs:string" minOccurs="0"/>
                </xs:sequence></xs:complexType>
            </xs:element>
        </xs:schema>
    </wsdl:types>
    <wsdl:message name="consultarPedido"><wsdl:part name="parameters" element="p:consultarPedido"/></wsdl:message>
    <wsdl:message name="consultarPedidoResponse"><wsdl:part name="parameters" element="p:consultarPedidoResponse"/></wsdl:message>
    <wsdl:portType name="Pedidos">
        <wsdl:operation name="consultarPedido">
            <wsdl:input message="p:consultarPedido"/>
            <wsdl:output message="p:consultarPedidoResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="PedidosBinding" type="p:Pedidos">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="consultarPedido">
            <soap:operation soapAction="consultarPedido"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input>
            <wsdl:output><soap:body use="literal"/></wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="PedidosService">
        <wsdl:port name="PedidosPort" binding="p:PedidosBinding"><soap:address location="http://localhost:8080/pedidos/ws/pedidos"/></wsdl:port>
    </wsdl:service>
</wsdl:definitions>
