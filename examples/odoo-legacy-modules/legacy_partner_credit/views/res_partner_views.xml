<odoo>
  <record id="view_partner_form_credit_legacy" model="ir.ui.view">
    <field name="name">res.partner.form.credit.legacy</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='vat']" position="after">
        <field name="x_credit_limit"/>
        <field name="x_credit_risk"/>
        <field name="x_legacy_segment"/>
      </xpath>
    </field>
  </record>
</odoo>
