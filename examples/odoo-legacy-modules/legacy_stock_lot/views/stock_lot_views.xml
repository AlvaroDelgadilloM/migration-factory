<odoo>
  <record id="view_production_lot_form_legacy" model="ir.ui.view">
    <field name="name">stock.production.lot.form.legacy</field>
    <field name="model">stock.production.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='ref']" position="after">
        <field name="x_quality_state"/>
        <field name="x_last_legacy_check"/>
      </xpath>
    </field>
  </record>
</odoo>
