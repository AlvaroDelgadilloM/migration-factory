<odoo>
  <record id="view_invoice_form_legacy_bridge" model="ir.ui.view">
    <field name="name">account.invoice.form.legacy.bridge</field>
    <field name="model">account.invoice</field>
    <field name="inherit_id" ref="account.invoice_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='reference']" position="after">
        <field name="x_external_invoice_id"/>
        <field name="x_legacy_exported" attrs="{'readonly': [('state', 'in', ['open','paid'])]}"/>
      </xpath>
    </field>
  </record>
</odoo>
