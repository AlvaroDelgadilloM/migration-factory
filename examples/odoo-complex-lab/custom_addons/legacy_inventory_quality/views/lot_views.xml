<odoo>
  <record id="lot_quality_form" model="ir.ui.view">
    <field name="name">stock.production.lot.quality.form</field>
    <field name="model">stock.production.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='ref']" position="after">
        <field name="x_external_batch"/>
        <field name="x_quality_state"/>
        <field name="x_quality_score"/>
      </xpath>
    </field>
  </record>
</odoo>
