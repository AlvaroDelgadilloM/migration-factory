<odoo>
  <record id="contract_form" model="ir.ui.view">
    <field name="name">legacy.sales.contract.form</field>
    <field name="model">legacy.sales.contract</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_activate" type="object" string="Activate" states="draft"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet><group>
          <field name="name"/><field name="partner_id"/>
          <field name="legacy_code"/><field name="discount_rate"/>
        </group></sheet>
      </form>
    </field>
  </record>
  <record id="contract_tree" model="ir.ui.view">
    <field name="name">legacy.sales.contract.tree</field>
    <field name="model">legacy.sales.contract</field>
    <field name="arch" type="xml">
      <tree><field name="name"/><field name="partner_id"/><field name="state"/></tree>
    </field>
  </record>
</odoo>
