<odoo>
  <record id="invoice_bridge_form" model="ir.ui.view">
    <field name="name">account.invoice.bridge.form</field>
    <field name="model">account.invoice</field>
    <field name="inherit_id" ref="account.invoice_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='reference']" position="after">
        <field name="x_external_invoice_id"/>
        <field name="x_export_state" attrs="{'readonly':[('state','in',['open','paid'])]}"/>
      </xpath>
    </field>
  </record>
</odoo>
