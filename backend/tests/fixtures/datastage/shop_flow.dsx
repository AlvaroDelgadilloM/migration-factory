BEGIN HEADER
   CharacterSet "CP1252"
   ExportingTool "IBM InfoSphere DataStage Export"
   ToolVersion "8"
   ServerName "DSSERVER.EXAMPLE.TEST"
   ToolInstanceID "SHOP"
   Date "2026-10-01"
   ServerVersion "11.7"
END HEADER
BEGIN DSJOB
   Identifier "JP_LOAD_ORDERS"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Name "JP_LOAD_ORDERS"
      Description "Carga pedidos y marca el primer registro de cada cliente"
      Parameters "CParameters"
      BEGIN DSSUBRECORD
         Name "P_CONN"
         Prompt "P_CONN parameters"
         Default "(As pre-defined)"
         ParamType "13"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "P_RUN_DATE"
         Prompt "Fecha de corrida"
         Default "2026-01-01"
         ParamType "0"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CCustomStage"
      Name "DB_100_READ_ORDERS"
      OutputPins "V0S1P1"
      StageType "OracleConnectorPX"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "XMLProperties"
         Value "<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Connection><Server modified='1' type='string'><![CDATA[#P_CONN.$P_SERVER#]]></Server><Username modified='1' type='string'><![CDATA[#P_CONN.$P_USER#]]></Username><Password modified='1' type='string'><![CDATA[#P_CONN.$P_PWD#]]></Password></Connection><Usage><SQL><SelectStatement modified='1' type='string'><![CDATA[SELECT CUSTOMER_ID, ORDER_ID, AMOUNT FROM #P_CONN.$P_SCHEMA#.ORDERS WHERE ORDER_DATE = DATE '#P_RUN_DATE#']]><Tables collapsed='1'><Table type='string'><![CDATA[#P_CONN.$P_SCHEMA#.ORDERS]]></Table></Tables></SelectStatement></SQL></Usage></Properties >"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CCustomOutput"
      Name "LK_DB100_TO_SO200"
      Partner "V0S2|V0S2P1"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "CUSTOMER_ID"
         SqlType "3"
         KeyPosition "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "ORDER_ID"
         SqlType "3"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "AMOUNT"
         SqlType "3"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CCustomStage"
      Name "SO_200_SORT"
      InputPins "V0S2P1"
      OutputPins "V0S2P2"
      StageType "PxSort"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "key"
         Value "(2)(2)0(1)(3)key(2)CUSTOMER_ID(2)0(1)(3)(3)asc\\desc(2)asc(2)0(1)(3)key(2)ORDER_ID(2)0(1)(3)(3)asc\\desc(2)desc(2)0"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CCustomInput"
      Name "LK_DB100_TO_SO200"
      Partner "V0S1|V0S1P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P2"
      OLEType "CCustomOutput"
      Name "LK_SO200_TO_TF300"
      Partner "V0S3|V0S3P1"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "CUSTOMER_ID"
         SqlType "3"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "ORDER_ID"
         SqlType "3"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "AMOUNT"
         SqlType "3"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3"
      OLEType "CTransformerStage"
      Name "TF_300_FLAG_FIRST"
      InputPins "V0S3P1"
      OutputPins "V0S3P2|V0S3P3"
      StageVars "CStageVar"
      BEGIN DSSUBRECORD
         Name "PrevCustomer"
         Expression "If isNull(Customer) Then setNull() Else Customer"
         InitialValue "SetNull()"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "Customer"
         Expression "LK_SO200_TO_TF300.CUSTOMER_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "Flag"
         Expression "If Customer <> PrevCustomer Then \"F\" Else \"N\""
      END DSSUBRECORD
      StageType "CTransformerStage"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P1"
      OLEType "CTrxInput"
      Name "LK_SO200_TO_TF300"
      Partner "V0S2|V0S2P2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P2"
      OLEType "CTrxOutput"
      Name "LK_TF300_TO_DB400"
      Partner "V0S4|V0S4P1"
      Constraint "Flag = \"F\""
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "CUSTOMER_ID"
         SqlType "3"
         Derivation "LK_SO200_TO_TF300.CUSTOMER_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "AMOUNT"
         SqlType "3"
         Derivation "NullToZero(LK_SO200_TO_TF300.AMOUNT)"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "LOADED_BY"
         SqlType "12"
         Derivation "P_CONN.$P_USER"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "LOADED_AT"
         SqlType "93"
         Derivation "CurrentTimestamp()"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P3"
      OLEType "CTrxOutput"
      Name "LK_TF300_TO_DS500"
      Partner "V0S5|V0S5P1"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "ORDER_ID"
         SqlType "3"
         KeyPosition "1"
         Derivation "LK_SO200_TO_TF300.ORDER_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "AMOUNT"
         SqlType "3"
         Derivation "LK_SO200_TO_TF300.AMOUNT"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4"
      OLEType "CCustomStage"
      Name "DB_400_INSERT_FIRST"
      InputPins "V0S4P1"
      StageType "OracleConnectorPX"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "XMLProperties"
         Value =+=+=+=
<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Connection><Server modified='1' type='string'><![CDATA[#P_CONN.$P_SERVER#]]></Server><Password modified='1' type='string'><![CDATA[#P_CONN.$P_PWD#]]></Password></Connection><Usage><WriteMode modified='1' type='int'><![CDATA[0]]></WriteMode><GenerateSQL modified='1' type='bool'><![CDATA[1]]></GenerateSQL><TableName modified='1' type='string'><![CDATA[#P_CONN.$P_SCHEMA#.FIRST_ORDERS]]></TableName></Usage></Properties >
=+=+=+=
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4P1"
      OLEType "CCustomInput"
      Name "LK_TF300_TO_DB400"
      Partner "V0S3|V0S3P2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S5"
      OLEType "CCustomStage"
      Name "DS_500_ORDERS_STAGE"
      InputPins "V0S5P1"
      StageType "PxDataSet"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S5P1"
      OLEType "CCustomInput"
      Name "LK_TF300_TO_DS500"
      Partner "V0S3|V0S3P3"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "dataset"
         Value "/data/tmp/orders_stage.ds"
      END DSSUBRECORD
   END DSRECORD
END DSJOB
BEGIN DSJOB
   Identifier "JP_PUBLISH"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Name "JP_PUBLISH"
      Parameters "CParameters"
      BEGIN DSSUBRECORD
         Name "P_CONN"
         ParamType "13"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CCustomStage"
      Name "DS_100_ORDERS_STAGE"
      OutputPins "V0S1P1"
      StageType "PxDataSet"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CCustomOutput"
      Name "LK_DS100_TO_DB200"
      Partner "V0S2|V0S2P1"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "dataset"
         Value "/data/tmp/orders_stage.ds"
      END DSSUBRECORD
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "ORDER_ID"
         SqlType "3"
         KeyPosition "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "AMOUNT"
         SqlType "3"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CCustomStage"
      Name "DB_200_UPDATE_TOTALS"
      InputPins "V0S2P1"
      StageType "OracleConnectorPX"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "XMLProperties"
         Value "<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Connection><Server modified='1' type='string'><![CDATA[#P_CONN.$P_SERVER#]]></Server></Connection><Usage><WriteMode modified='1' type='int'><![CDATA[1]]></WriteMode><GenerateSQL modified='1' type='bool'><![CDATA[1]]></GenerateSQL><TableName modified='1' type='string'><![CDATA[#P_CONN.$P_SCHEMA#.ORDER_TOTALS]]></TableName></Usage></Properties >"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CCustomInput"
      Name "LK_DS100_TO_DB200"
      Partner "V0S1|V0S1P1"
   END DSRECORD
END DSJOB
BEGIN DSJOB
   Identifier "JS_MASTER"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Name "JS_MASTER"
      Parameters "CParameters"
      BEGIN DSSUBRECORD
         Name "P_MODE"
         Default "FULL"
         ParamType "0"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CJSJobActivity"
      Name "JA_100_LOAD"
      OutputPins "V0S1P1"
      Jobname "JP_LOAD_ORDERS"
      StageType "CJobActivity"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CJSActivityOutput"
      Name "LK_JA100_TO_NC200"
      Partner "V0S2|V0S2P1"
      ConditionType "0"
      TriggerExpression "N/A"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CJSCondition"
      Name "NC_200_MODE"
      InputPins "V0S2P1"
      OutputPins "V0S2P2|V0S2P3"
      StageType "CCondition"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CJSActivityInput"
      Name "LK_JA100_TO_NC200"
      Partner "V0S1|V0S1P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P2"
      OLEType "CJSActivityOutput"
      Name "LK_NC200_TO_JA300"
      Partner "V0S3|V0S3P1"
      ConditionType "6"
      TriggerExpression "P_MODE = 'FULL'"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P3"
      OLEType "CJSActivityOutput"
      Name "LK_NC200_TO_TA500"
      Partner "V0S5|V0S5P1"
      ConditionType "0"
      TriggerExpression "N/A"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3"
      OLEType "CJSJobActivity"
      Name "JA_300_PUBLISH"
      InputPins "V0S3P1"
      Jobname "JP_PUBLISH"
      StageType "CJobActivity"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P1"
      OLEType "CJSActivityInput"
      Name "LK_NC200_TO_JA300"
      Partner "V0S2|V0S2P2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4"
      OLEType "CJSExceptionHandler"
      Name "EX_400_ERROR"
      OutputPins "V0S4P1"
      StageType "CExceptionHandler"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4P1"
      OLEType "CJSActivityOutput"
      Name "LK_EX400_TO_TA500"
      Partner "V0S5|V0S5P2"
      ConditionType "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S5"
      OLEType "CJSTerminatorActivity"
      Name "TA_500_ABORT"
      InputPins "V0S5P1|V0S5P2"
      FinalMessage "Flujo abortado"
      StageType "CTerminatorActivity"
   END DSRECORD
END DSJOB
BEGIN DSJOB
   Identifier "JP_LEGACY_KEYS"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Name "JP_LEGACY_KEYS"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CCustomStage"
      Name "DB_100_LEGACY"
      OutputPins "V0S1P1"
      StageType "OracleConnectorPX"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "XMLProperties"
         Value "<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Connection><Server type='string'><![CDATA[legacydb.example.test]]></Server><Username type='string'><![CDATA[etl_user]]></Username><Password type='string'><![CDATA[S3cretLiteral!]]></Password></Connection><Usage><SQL><SelectStatement type='string'><![CDATA[SELECT ID FROM KEYS]]></SelectStatement></SQL></Usage></Properties >"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CCustomOutput"
      Name "LK_DB100_TO_SK200"
      Partner "V0S2|V0S2P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CCustomStage"
      Name "SK_200_SURROGATE"
      InputPins "V0S2P1"
      StageType "PxSurrogateKeyGenerator"
      FutureProperty "kept as data"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CCustomInput"
      Name "LK_DB100_TO_SK200"
      Partner "V0S1|V0S1P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S9"
      OLEType "CFutureRecordType"
      Name "UNKNOWN_RECORD"
   END DSRECORD
END DSJOB
