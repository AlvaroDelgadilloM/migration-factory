# Copy to .env and replace values. Generate random values, e.g.: openssl rand -hex 32
# Never commit .env.
POSTGRES_PASSWORD=replace-with-random-value
REDIS_PASSWORD=replace-with-random-value
# Dev auth (MF_AUTH_MODE=dev) signs demo tokens with this key (>= 32 chars). Refused when MF_ENV=production.
MF_DEV_JWT_SECRET=replace-with-at-least-32-random-characters

# OIDC (MF_AUTH_MODE=oidc). Local end-to-end test: docker-compose.oidc.yml + scripts/oidc_e2e.py (see README).
MF_AUTH_MODE=dev
MF_OIDC_ISSUER=
MF_OIDC_AUDIENCE=
MF_OIDC_JWKS_URL=
MF_OIDC_CLIENT_ID=migration-factory-ui

# Git hosts allowed for repository registration (SSRF allowlist)
MF_GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
# Maven mirror used by the worker (all repositories are mirrored to it)
MF_MAVEN_MIRROR_URL=https://repo1.maven.org/maven2
# Additional approved repositories (comma separated id|https-url). Example needed by CXF WS-Security (opensaml):
# MF_MAVEN_EXTRA_REPOS=shibboleth|https://build.shibboleth.net/maven/releases
MF_MAVEN_EXTRA_REPOS=
# Red de Maven: offline (solo repositorio local, mvn -o) | central (solo el mirror aprobado) | allowlist (mirror + repos extra)
MF_MAVEN_NETWORK=allowlist
MF_JOB_TIMEOUT_SECONDS=1800
MF_STEP_TIMEOUT_SECONDS=900

# Host directory exposed read-only as /sources for "Carpeta local" projects (paths are seen by the worker as /sources/...)
MF_HOST_SOURCES_DIR=./examples
# Max ZIP upload size
MF_MAX_UPLOAD_MB=200
# Host port for the web UI
# Host ports (127.0.0.1 only; the containers keep 8080/8000 inside): UI and API from 3240 on
MF_UI_PORT=3240
MF_API_PORT=3241

# development | production (production refuses MF_AUTH_MODE=dev)
MF_ENV=development

# Local OIDC test profile (docker-compose.oidc.yml + scripts/oidc_e2e.py): Keycloak bootstrap admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-value

# Draft PRs (Git-source projects): fine-grained GitHub token limited to the target repository
# (Contents: read/write, Pull requests: read/write). Project setting: credentialRef = env:MF_CRED_GITHUB
MF_CRED_GITHUB=

# Days after which candidates, patches and old snapshots are deleted (reports, logs and audit are kept); 0 = never
MF_ARTIFACT_RETENTION_DAYS=30
